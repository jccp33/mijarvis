OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Saved UI settings are overridden by these variables on restart.
# Optional response language: es or en.
# MIJARVIS_LANGUAGE=es
# Optional shared data directory (desktop and standalone Core use the same default).
# MIJARVIS_DATA_DIR=C:/Users/your-user/AppData/Local/MiJarvis
# To use another .env, export MIJARVIS_ENV_FILE before launch (not inside this file).
# Both entrypoints otherwise read the repository root .env.
# Optional request settings. Core otherwise uses model num_ctx or 2048 tokens.
# OLLAMA_NUM_CTX=2048
# OLLAMA_NUM_GPU=0
CORE_PORT=4317
# Required only for standalone Core; desktop generates a session token.
CORE_TOKEN=replace-with-a-long-random-secret
